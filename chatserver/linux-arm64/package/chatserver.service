[Unit]
Description=ChatServer Linux ARM64
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=chatserver
Group=chatserver
ExecStart=/usr/local/bin/chatserver serve /etc/chatserver/chatserver.toml
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true
CapabilityBoundingSet=
AmbientCapabilities=
ReadWritePaths=/var/lib/chatserver
UMask=0077

[Install]
WantedBy=multi-user.target

